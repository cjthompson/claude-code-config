#!/usr/bin/env node
/**
 * task-db — SQLite helper for the project-tasks skill.
 *
 * Ships in the plugin's bin/ directory. On Claude Code that dir is added to the
 * Bash tool's PATH (invoked as the bare command `task-db`); other hosts (e.g.
 * Codex) run it via `node <path-to-bin/task-db>`. Set PROJECT_TASKS_HOME (or
 * CODEX_HOME) to choose the DB location; defaults to ~/.claude.
 *
 * All SQL is handled internally. Callers pass plain string arguments; no shell
 * escaping is needed on the caller side.
 *
 * This file is now dispatch and nothing else — three layers, each testable
 * without the other two:
 *
 *     lib/cli.mjs       argv → validated Action   (pure; no sqlite3)
 *     lib/handlers.mjs  Action → effect           (one function per command)
 *     lib/db.mjs        the sqlite3 process layer
 *
 * The old flat `switch (cmd)` and its `get`/`all`/`has` argv helpers are gone.
 * Those helpers `indexOf`'d the whole argv and reported nothing: `get('--title')`
 * returned the NEXT FLAG when the value was omitted, and an unknown command was
 * the only thing that ever failed. Every legacy flat name now errors naming its
 * replacement — `parseArgv` raises it from `RENAMES`, this file only surfaces it.
 *
 * Exit codes are returned by handlers, never thrown by `process.exit` mid-write:
 * setting `process.exitCode` lets Node flush stdout before exiting, which
 * `process.exit()` does not guarantee when stdout is a pipe. `db init` still
 * exits 2 on a first-time setup.
 */

import { CliError, parseArgv } from '../lib/cli.mjs';
import { DbError } from '../lib/db.mjs';
import { HANDLERS } from '../lib/handlers.mjs';

/** @returns {number} the process exit code */
function main() {
    const action = parseArgv(process.argv.slice(2));

    // A bare `task-db`, a group with no leaf (`task deps`), or an explicit
    // --help are all requests for usage rather than failures.
    if (action.kind === 'help') {
        process.stdout.write(`${action.usage}\n`);
        return 0;
    }

    const handler = HANDLERS[action.handler];
    if (!handler) {
        throw new CliError(
            `ERROR: internal: no handler named '${action.handler}' for '${action.command}'.`,
        );
    }
    return handler(action) ?? 0;
}

try {
    process.exitCode = main();
} catch (err) {
    if (err instanceof CliError || err instanceof DbError) {
        process.stderr.write(`${err.message}\n`);
        process.exitCode = err.exitCode;
    } else {
        throw err;
    }
}
