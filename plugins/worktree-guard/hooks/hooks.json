{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|NotebookEdit|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-guard.py\" pre-tool-use",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-guard.py\" session-start",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
