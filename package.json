{
  "name": "@cjthompson/claude-code-config",
  "version": "0.0.68",
  "workspaces": [
    "packages/installer"
  ],
  "scripts": {
    "install-packages": "npm -w @cjthompson/claude-code-config-installer start",
    "reinstall": "npm -w @cjthompson/claude-code-config-installer run reinstall",
    "install-package": "npm -w @cjthompson/claude-code-config-installer run install-package --",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p packages/installer/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
